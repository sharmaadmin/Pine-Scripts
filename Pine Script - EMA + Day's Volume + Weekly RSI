    //RVolume
    table.cell(status_table, 0, 6, "RVOL (" + str.tostring(avgLen) + ")", text_color =color.gray)
    table.cell(status_table, 1, 6, str.tostring(rvol, "#.##") + " Times", bgcolor=rvol > 1 ? color.new(color.green, 50) : color.new(color.red, 50), text_color=color.blue, text_halign=text.align_center)    
    table.cell(status_table, 2, 6, "         ", bgcolor=color.white, text_color=color.white)
