// --- Calculations: EMA Status ---
// We use a simple security call for Daily, Weekly, Monthly
d_ema = request.security(syminfo.tickerid, "D", ta.ema(close, ema_length))
d_price = request.security(syminfo.tickerid, "D", close)

w_ema = request.security(syminfo.tickerid, "W", ta.ema(close, ema_length))
w_price = request.security(syminfo.tickerid, "W", close)

m_ema = request.security(syminfo.tickerid, "M", ta.ema(close, ema_length))
m_price = request.security(syminfo.tickerid, "M", close)

is_daily_bull   = d_price > d_ema
is_weekly_bull  = w_price > w_ema
is_monthly_bull = m_price > m_ema

// Variables For RVolume
