// Code Starts --> Displaying Current Day's Volume
// --- USER DEFINED FUNCTION (UDF) ---
// This function takes any number and returns a string in Indian format
formatIndian(float num) =>
    string s = str.tostring(math.floor(num), "#")
    int len = str.length(s)
    string res = ""
    
    if len <= 3
        res := s
    else
        // Extract the last 3 digits
        res := "," + str.substring(s, len - 3)
        // Process the rest in pairs of 2
        string remaining = str.substring(s, 0, len - 3)
        int remLen = str.length(remaining)
        
        for i = remLen to 1 by 2
            int start = i - 2
            if start >= 0
                res := (start == 0 ? "" : ",") + str.substring(remaining, start, i) + res
            else
                // Handle single leading digit (e.g., the '1' in 1,00,000)
                res := str.substring(remaining, 0, 1) + res
    
    // Add the Rupee symbol and return the final string
    " " + res
// --- MAIN EXECUTION ---

// 1. Get the daily volume
