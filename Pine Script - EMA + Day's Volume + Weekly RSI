    // Weekly
    table.cell(status_table, 0, 2, "Weekly > 21EMA", text_color=color.gray)
    table.cell(status_table, 1, 2, is_weekly_bull ? "Above" : "Below", bgcolor = is_weekly_bull ? pos_color : neg_color, text_color=color.white)
    table.cell(status_table, 2, 2, "         ", bgcolor=color.white, text_color=color.white)
    
    // Monthly
    table.cell(status_table, 0, 3, "Monthly > 21EMA", text_color=color.gray)
    table.cell(status_table, 1, 3, is_monthly_bull ? "Above" : "Below", bgcolor = is_monthly_bull ? pos_color : neg_color, text_color=color.white)
